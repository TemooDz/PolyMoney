# Polymarket Tracker — Environment Variables
# Copy this file to ".env" and fill in your values.

# Your Gmail address (used as the sender)
GMAIL_USER=temoodzneladze@gmail.com

# Gmail App Password (NOT your regular Google password!)
# How to get one:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already on
#   3. Search for "App passwords" → create one for "Mail"
#   4. Copy the 16-character password here (spaces are fine)
GMAIL_APP_PASSWORD=idqj bdff aswt paut

# Who receives the daily email
RECIPIENT_EMAIL=temoodzneladze@gmail.com
